# The app derives the API address from the address the browser used to open it,
# so a phone on the same Wi-Fi reaches the backend without an address being set
# here, and a new address from the router keeps working on its own.
#
# Set VITE_API_URL only for a deployment where the API does not sit on the same
# host as the app, on port 8000.
# VITE_API_URL=https://api.example.com/api

# How the app reaches the API when VITE_API_URL is not set:
#   proxy  (default) calls /api on the app's own address. The Vite dev server
#          forwards it to Laravel on http://127.0.0.1:8000, so one ngrok tunnel
#          on port 8100 covers both the app and the API.
#   direct calls port 8000 on the host the browser used, for a setup without
#          the Vite proxy.
# VITE_API_MODE=direct
