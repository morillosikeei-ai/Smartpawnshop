# The API address the browser calls. It must be reachable from the device
# running the app, so a phone on the same Wi-Fi needs the machine's LAN
# address here, not 127.0.0.1, which on a phone means the phone itself.
#
# Change this when the machine's LAN IP changes, and keep FRONTEND_URL and
# CORS_ALLOWED_ORIGINS in pawnsmart-api/.env pointing at the same address.
VITE_API_URL=http://192.168.1.12:8000/api
